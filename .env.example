# Required. Encrypts bank credentials and 2FA secrets. Generate with:
#   openssl rand -base64 48
# Back this up somewhere safe (password manager). Lose it and you must
# reconnect SimpleFIN and re-enroll 2FA.
APP_SECRET=

# Encrypts nightly backups. Defaults to APP_SECRET if empty. Keep a copy off the server.
BACKUP_PASSPHRASE=

# Set to true when serving over HTTPS (e.g. Tailscale Serve), so cookies are Secure-only.
COOKIE_SECURE=false

# Optional overrides (cron syntax, household time zone)
# SYNC_CRON=15 6 * * *
# BACKUP_CRON=30 2 * * *
